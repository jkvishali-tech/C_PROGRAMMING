FINDING THE GREATEST NUMBER

/ / Greatest Of Two Number / /
#include<stdio.h>
int main()
{
    int a,b;
    scanf("%d%d",&a,&b);
    if(a>b)
    printf("a");
    else
    printf("b");
}
*********************************************************************
/ / Greatest Of Three Number / /
#include<stdio.h>
int main()
{
    int a,b,c;
    scanf("%d%d%d",&a,&b,&c);
    if((a>b)&&(a>c))
    printf("a");
    else if(b>c)
    printf("b");
    else
    printf("c");
}
