TOPIC-07
SUM OF A NUMBER [WHILE LOOP]

#include<stdio.h>
int main()
{
    int n,sum=0,d;
    scanf("%d",&n);
    while(n!=0)
    {
        d=n%10;
        sum=sum+d;
        n=n/10;
    }
    printf("%d",sum);
}
