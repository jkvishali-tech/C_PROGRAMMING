TOPIC-04
SQUARE NUMBER PATTERN

/ / Repeating Row Numbers / /
#include<stdio.h>
int main()
{
    int n,col,row;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
        for(col=0;col<n;col++)
        printf("1");
    }
}
********************************************************************
/ / Counting Column Numbers / /
#include<stdio.h>
int main()
{
    int n,row,i,col;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
        for(col=0;col<n;col++)
        printf("%d",col+1);
    }
}
**********************************************************************
/ / Right-Angled Number Triangle Pattern / /
#include<stdio.h>
int main()
{
    int n,row,i,col;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
        for(col=0;col<=row;col++)
        printf("%d",col+1);
    }
}
