TOPIC-02
COMBINATION OF TWO BASES

/ / Base-01;Base-02 / /
#include<stdio.h>
int main()
{
    int n,row,col;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
        for(col=0;col<=row-1;col++)
        printf(" ");
        for(col=0;col<n;col++)
        printf("*");
    }
}
