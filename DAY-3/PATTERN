TOPIC-03
COMBINATION OF THREE BASES

/ / Base-02;Base-03;Base-02 / /
#include<stdio.h>
int main()
{
    int n,col,row;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
        for(col=0;col<=row;col++)
        printf("*");
        for(col=0;col<n-row;col++)
        printf(" ");
        for(col=0;col<=row;col++)
        printf("*");
    }
}

